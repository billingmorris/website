<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Correo al cliente cuando envía un pedido desde la app (sintaxis de plantillas de Odoo 14) -->
        <record id="mail_template_order_received" model="mail.template">
            <field name="name">App Mayorista: pedido recibido</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">${object.company_id.name}: recibimos su pedido ${object.name}</field>
            <field name="email_from">${(object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) | safe}</field>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hola ${object.partner_id.name},</p>
    <p>Recibimos su pedido <strong>${object.name}</strong> por un total de
        <strong>${format_amount(object.amount_total, object.currency_id)}</strong>.</p>
    <p>Le avisaremos en la app cada vez que su pedido avance.</p>
    <p><a href="${object.get_base_url()}/mayorista/pedidos/${object.id}"
          style="display: inline-block; padding: 10px 16px; background: #2f5d8a; color: #ffffff; text-decoration: none; border-radius: 6px;">Ver mi pedido</a></p>
</div>
            </field>
        </record>

        <!-- Correo al cliente cuando el pedido cambia a una etapa con "Enviar también correo" -->
        <record id="mail_template_stage_update" model="mail.template">
            <field name="name">App Mayorista: actualización de pedido</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Su pedido ${object.name}: ${object.wholesale_stage_id.name}</field>
            <field name="email_from">${(object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) | safe}</field>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hola ${object.partner_id.name},</p>
    <p>Su pedido <strong>${object.name}</strong> está ahora en la etapa
        <strong>${object.wholesale_stage_id.name}</strong>.</p>
    % if object.wholesale_stage_id.description:
    <p>${object.wholesale_stage_id.description}</p>
    % endif
    <p><a href="${object.get_base_url()}/mayorista/pedidos/${object.id}"
          style="display: inline-block; padding: 10px 16px; background: #2f5d8a; color: #ffffff; text-decoration: none; border-radius: 6px;">Ver seguimiento</a></p>
</div>
            </field>
        </record>
    </data>
</odoo>
