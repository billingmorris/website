<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wholesale_notification_tree" model="ir.ui.view">
        <field name="name">wholesale.notification.tree</field>
        <field name="model">wholesale.notification</field>
        <field name="arch" type="xml">
            <tree string="Notificaciones a clientes" decoration-bf="not is_read">
                <field name="create_date" string="Fecha"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="kind"/>
                <field name="title"/>
                <field name="is_read"/>
            </tree>
        </field>
    </record>

    <record id="view_wholesale_notification_form" model="ir.ui.view">
        <field name="name">wholesale.notification.form</field>
        <field name="model">wholesale.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación a cliente">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="order_id" options="{'no_create': True}"
                                   domain="[('is_wholesale_app', '=', True)]"/>
                        </group>
                        <group>
                            <field name="kind"/>
                            <field name="is_read"/>
                        </group>
                    </group>
                    <field name="title" placeholder="Título"/>
                    <field name="body" placeholder="Mensaje para el cliente…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wholesale_notification_search" model="ir.ui.view">
        <field name="name">wholesale.notification.search</field>
        <field name="model">wholesale.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="title"/>
                <filter name="unread" string="Sin leer" domain="[('is_read', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wholesale_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones a clientes</field>
        <field name="res_model">wholesale.notification</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí aparecen los avisos que ven los clientes en la app</p>
            <p>Se crean solos al cambiar la etapa o el estado de un pedido; también puede escribir uno manualmente.</p>
        </field>
    </record>
</odoo>
