<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 14: los assets del frontend se registran heredando el bundle web.assets_frontend -->
    <template id="assets_frontend" inherit_id="web.assets_frontend" name="App Mayorista - assets">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css" href="/website_mayorista/static/src/css/mayorista.css"/>
            <script type="text/javascript" src="/website_mayorista/static/src/js/mayorista.js"/>
        </xpath>
    </template>
</odoo>
