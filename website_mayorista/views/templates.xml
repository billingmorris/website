<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         ESTRUCTURA COMÚN DE LA APP
         Barra superior (menú, logo/nombre, WhatsApp, notificaciones), menú lateral,
         chat con el comercial, aviso de instalación en iPhone y avisos flotantes.
         Uso: <t t-call="website_mayorista.app_layout"> contenido </t>
         Variables opcionales: header_extra (HTML bajo la barra), show_cartbar, page_class.
         ===================================================================== -->
    <template id="app_layout" name="App Mayorista: estructura">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="page_title or app_name"/>
            <div id="wrap">
                <div t-attf-class="o_mayorista_app #{page_class or ''} #{'o_my_has_bg' if bg_url else ''}"
                     t-att-style="app_style">

                    <header class="o_my_header">
                        <div class="o_my_appbar">
                            <button type="button" class="o_my_icon_btn o_my_menu_btn" aria-label="Abrir menú"
                                    aria-controls="o_my_drawer" aria-expanded="false">
                                <i class="fa fa-bars"/>
                            </button>
                            <a href="/mayorista" class="o_my_brand">
                                <img t-if="logo_url" t-att-src="logo_url" alt="" class="o_my_brand_logo"/>
                                <span class="o_my_brand_name" t-esc="app_name"/>
                            </a>
                            <div class="o_my_appbar_actions">
                                <a t-if="whatsapp_url" t-att-href="whatsapp_url" target="_blank" rel="noopener"
                                   class="o_my_icon_btn o_my_whatsapp" aria-label="Escribir por WhatsApp">
                                    <i class="fa fa-whatsapp"/>
                                </a>
                                <a href="/mayorista/notificaciones" class="o_my_icon_btn o_my_bell"
                                   aria-label="Notificaciones">
                                    <i class="fa fa-bell-o"/>
                                    <span t-attf-class="o_my_badge js_my_notif_badge #{'' if notif_unread else 'd-none'}"
                                          t-esc="notif_unread_label"/>
                                </a>
                            </div>
                        </div>
                        <t t-raw="header_extra or ''"/>
                    </header>

                    <!-- Menú lateral -->
                    <div class="o_my_backdrop"/>
                    <nav id="o_my_drawer" class="o_my_drawer" aria-label="Menú de la app">
                        <div class="o_my_drawer_head">
                            <div>
                                <strong t-esc="app_name"/>
                                <span class="o_my_drawer_user" t-esc="request.env.user.partner_id.display_name"/>
                            </div>
                            <button type="button" class="o_my_icon_btn o_my_drawer_close" aria-label="Cerrar menú">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <a href="/mayorista" t-attf-class="o_my_nav #{'active' if app_page == 'catalog' else ''}">
                            <i class="fa fa-th-large"/> Catálogo
                        </a>
                        <a href="/mayorista/carrito" t-attf-class="o_my_nav #{'active' if app_page == 'cart' else ''}">
                            <i class="fa fa-shopping-basket"/> Pedido en curso
                        </a>
                        <a href="/mayorista/pedidos" t-attf-class="o_my_nav #{'active' if app_page == 'orders' else ''}">
                            <i class="fa fa-truck"/> Mis pedidos
                        </a>
                        <a href="/mayorista/notificaciones"
                           t-attf-class="o_my_nav #{'active' if app_page == 'notifications' else ''}">
                            <i class="fa fa-bell-o"/> Notificaciones
                        </a>
                        <button t-if="chat_enabled" type="button" class="o_my_nav o_my_chat_open">
                            <i class="fa fa-comments-o"/> Escribir a mi asesor
                        </button>
                        <a t-if="whatsapp_url" t-att-href="whatsapp_url" target="_blank" rel="noopener" class="o_my_nav">
                            <i class="fa fa-whatsapp"/> WhatsApp
                        </a>
                        <a href="/my" class="o_my_nav"><i class="fa fa-user-o"/> Mi cuenta</a>
                        <button type="button" class="o_my_nav o_my_install d-none">
                            <i class="fa fa-download"/> Instalar app
                        </button>
                        <a href="/web/session/logout?redirect=/mayorista" class="o_my_nav o_my_nav_muted">
                            <i class="fa fa-sign-out"/> Cerrar sesión
                        </a>
                    </nav>

                    <main class="o_my_main">
                        <t t-raw="0"/>
                    </main>

                    <t t-if="show_cartbar" t-call="website_mayorista.cart_bar"/>

                    <!-- Chat con el comercial -->
                    <t t-if="chat_enabled">
                        <button type="button" class="o_my_chat_fab o_my_chat_open" aria-label="Escribir a mi asesor">
                            <i class="fa fa-comments"/>
                            <span class="o_my_badge js_my_chat_badge d-none"/>
                        </button>
                        <section class="o_my_chat" aria-label="Chat con su asesor" hidden="hidden">
                            <header class="o_my_chat_head">
                                <div>
                                    <strong>Su asesor</strong>
                                    <span class="o_my_chat_agent" t-esc="chat_agent"/>
                                </div>
                                <button type="button" class="o_my_icon_btn o_my_chat_close" aria-label="Cerrar chat">
                                    <i class="fa fa-times"/>
                                </button>
                            </header>
                            <div class="o_my_chat_log" role="log" aria-live="polite">
                                <p class="o_my_chat_empty">Escriba su consulta. Su asesor le responde aquí.</p>
                            </div>
                            <form class="o_my_chat_form">
                                <textarea class="o_my_chat_input" rows="1" maxlength="2000"
                                          placeholder="Escriba un mensaje" aria-label="Mensaje"></textarea>
                                <button type="submit" class="o_my_chat_send" aria-label="Enviar mensaje">
                                    <i class="fa fa-paper-plane"/>
                                </button>
                            </form>
                        </section>
                    </t>

                    <div class="o_my_ios_hint" role="dialog" aria-label="Instalar en iPhone" hidden="hidden">
                        <p><strong>Instalar en iPhone o iPad</strong></p>
                        <p>En Safari, toque <i class="fa fa-share-square-o" aria-hidden="true"/> Compartir y elija
                            «Agregar a pantalla de inicio».</p>
                        <button type="button" class="o_my_btn o_my_btn_ghost o_my_ios_hint_close">Entendido</button>
                    </div>
                    <div class="o_my_toast" role="status" aria-live="polite"/>
                </div>
            </div>
        </t>
    </template>

    <!-- =====================================================================
         COMPONENTES
         ===================================================================== -->

    <!-- Tarjeta de producto (lista, galería y destacados). Variables: p, currency -->
    <template id="product_card" name="App Mayorista: tarjeta de producto">
        <article t-attf-class="o_my_card #{'o_my_in_cart' if p['in_cart'] else ''}"
                 t-att-data-product-id="p['id']">
            <img class="o_my_card_img" t-att-src="p['image_url']" t-att-alt="p['name']"
                 loading="lazy" width="64" height="64"/>
            <div class="o_my_card_body">
                <h3 class="o_my_card_name" t-att-title="p['name']" t-esc="p['name']"/>
                <div class="o_my_card_code" t-if="p['code']">Cód. <t t-esc="p['code']"/></div>
                <div class="o_my_card_meta">
                    <span class="o_my_card_price" t-esc="p['price']"
                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                    <span t-if="p['stock_state']" t-attf-class="o_my_stock o_my_stock_#{p['stock_state']}">
                        <t t-if="p['stock_state'] == 'out'">Agotado</t>
                        <t t-else="">Disp. <t t-esc="p['stock_display']"/></t>
                    </span>
                </div>
            </div>
            <t t-call="website_mayorista.qty_stepper">
                <t t-set="qty" t-value="p['qty']"/>
                <t t-set="max_qty" t-value="p['max_qty']"/>
            </t>
        </article>
    </template>

    <template id="qty_stepper" name="App Mayorista: selector de cantidad">
        <div class="o_my_stepper">
            <button type="button" class="o_my_qty_btn o_my_qty_minus" data-delta="-1" aria-label="Quitar una unidad">−</button>
            <input type="number" class="o_my_qty_input" min="0" step="1" inputmode="numeric"
                   placeholder="0" aria-label="Cantidad" t-att-value="qty" t-att-max="max_qty"/>
            <button type="button" class="o_my_qty_btn o_my_qty_plus" data-delta="1" aria-label="Agregar una unidad">+</button>
        </div>
    </template>

    <!-- Lista de tarjetas: en la página y en /mayorista/productos (JSON) -->
    <template id="product_items" name="App Mayorista: lista de productos">
        <t t-foreach="products" t-as="p">
            <t t-call="website_mayorista.product_card"/>
        </t>
    </template>

    <!-- Barra inferior con el total del pedido en curso -->
    <template id="cart_bar" name="App Mayorista: barra del pedido">
        <div t-attf-class="o_my_cartbar #{'' if cart['has_lines'] else 'o_my_cartbar_empty'}">
            <a href="/mayorista/carrito" class="o_my_cartbar_link">
                <span class="o_my_cartbar_info">
                    <i class="fa fa-shopping-basket" aria-hidden="true"/>
                    <span><span class="js_my_lines" t-esc="cart['lines']"/> productos</span>
                </span>
                <span class="o_my_cartbar_total js_my_total" t-esc="cart['amount_total']"/>
                <span class="o_my_cartbar_cta">Revisar pedido</span>
            </a>
        </div>
    </template>

    <!-- Totales (pedido en curso, confirmación y detalle). Variable: cart -->
    <template id="totals" name="App Mayorista: totales">
        <dl class="o_my_totals">
            <div><dt>Productos</dt><dd class="js_my_products_subtotal" t-esc="cart['products_subtotal']"/></div>
            <div t-if="cart['has_shipping']"><dt>Envío</dt><dd class="js_my_shipping" t-esc="cart['shipping']"/></div>
            <div><dt>Impuestos</dt><dd class="js_my_tax" t-esc="cart['amount_tax']"/></div>
            <div class="o_my_totals_total"><dt>Total</dt><dd class="js_my_total" t-esc="cart['amount_total']"/></div>
        </dl>
    </template>

    <!-- Líneas de solo lectura agrupadas por categoría. Variables: groups, order -->
    <template id="grouped_lines" name="App Mayorista: líneas por categoría">
        <div class="o_my_groups">
            <section t-foreach="groups" t-as="group" class="o_my_group">
                <h3 class="o_my_group_title">
                    <t t-esc="group['name']"/> <span class="o_my_group_count" t-esc="group['count']"/>
                </h3>
                <ul class="o_my_lines">
                    <li t-foreach="group['lines']" t-as="line" class="o_my_line">
                        <span class="o_my_line_qty" t-esc="'%g' % line.product_uom_qty"/>
                        <span class="o_my_line_name">
                            <t t-esc="line.product_id.with_context(display_default_code=False).display_name"/>
                            <small t-if="line.product_id.default_code" class="o_my_line_code"
                                   t-esc="line.product_id.default_code"/>
                        </span>
                        <span class="o_my_line_amount" t-esc="line.price_subtotal"
                              t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                    </li>
                </ul>
            </section>
        </div>
    </template>

    <!-- =====================================================================
         CATÁLOGO: /mayorista
         ===================================================================== -->
    <template id="app_page" name="App Mayorista: catálogo">
        <t t-set="show_cartbar" t-value="True"/>
        <t t-set="header_extra">
            <div class="o_my_toolbar">
                <form class="o_my_search" action="/mayorista" method="get" role="search">
                    <input t-if="category" type="hidden" name="category" t-att-value="category.id"/>
                    <i class="fa fa-search o_my_search_icon" aria-hidden="true"/>
                    <input type="search" name="search" class="o_my_search_input"
                           t-att-value="search" placeholder="Buscar por nombre o código"
                           autocomplete="off" enterkeyhint="search" aria-label="Buscar productos"/>
                </form>
                <div class="o_my_view_toggle" role="group" aria-label="Tipo de vista">
                    <button type="button" class="o_my_view_btn active" data-view="list"
                            aria-label="Vista lista" aria-pressed="true"><i class="fa fa-list"/></button>
                    <button type="button" class="o_my_view_btn" data-view="gallery"
                            aria-label="Vista galería" aria-pressed="false"><i class="fa fa-th-large"/></button>
                </div>
            </div>
        </t>
        <t t-call="website_mayorista.app_layout">
            <nav class="o_my_categories" aria-label="Categorías">
                <a href="/mayorista" t-attf-class="o_my_chip #{'active' if not category else ''}">Todo</a>
                <t t-foreach="categories" t-as="c">
                    <a t-attf-href="/mayorista?category=#{c.id}"
                       t-attf-class="o_my_chip #{'active' if c == active_root else ''}" t-esc="c.name"/>
                </t>
            </nav>
            <nav t-if="subcategories" class="o_my_categories o_my_subcategories" aria-label="Subcategorías">
                <t t-foreach="subcategories" t-as="c">
                    <a t-attf-href="/mayorista?category=#{c.id}"
                       t-attf-class="o_my_chip #{'active' if c == category else ''}" t-esc="c.name"/>
                </t>
            </nav>

            <section t-if="featured" class="o_my_featured" aria-label="Productos destacados">
                <h2 class="o_my_section_title">Destacados</h2>
                <div class="o_my_featured_track">
                    <t t-foreach="featured" t-as="p">
                        <t t-call="website_mayorista.product_card"/>
                    </t>
                </div>
            </section>

            <section class="o_my_catalog"
                     t-att-data-search="search"
                     t-att-data-category="category.id if category else ''"
                     t-att-data-offset="next_offset">
                <h2 class="o_my_section_title">
                    <t t-if="category"><t t-esc="category.name"/>: </t>
                    <span class="o_my_result_count" t-esc="count_label"/> productos
                </h2>
                <div class="o_my_products o_my_view_list">
                    <t t-call="website_mayorista.product_items"/>
                </div>
                <div t-attf-class="o_my_empty #{'d-none' if count else ''}">
                    <p>No hay productos que coincidan con la búsqueda.</p>
                    <a href="/mayorista" class="o_my_btn o_my_btn_ghost">Ver todo el catálogo</a>
                </div>
                <button type="button" t-attf-class="o_my_btn o_my_btn_ghost o_my_load_more #{'' if has_more else 'd-none'}">
                    Cargar más productos
                </button>
            </section>
        </t>
    </template>

    <!-- =====================================================================
         PEDIDO EN CURSO: /mayorista/carrito (agrupado por categoría, A-Z)
         ===================================================================== -->
    <template id="cart_page" name="App Mayorista: pedido en curso">
        <t t-set="page_class" t-value="'o_my_is_cart'"/>
        <t t-call="website_mayorista.app_layout">
            <div class="o_my_container">
                <h1 class="o_my_page_title">Pedido en curso</h1>
                <div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/>

                <t t-if="cart['has_lines']">
                    <section t-foreach="groups" t-as="group" class="o_my_group">
                        <h3 class="o_my_group_title">
                            <t t-esc="group['name']"/> <span class="o_my_group_count" t-esc="group['count']"/>
                        </h3>
                        <div class="o_my_products o_my_view_list">
                            <t t-foreach="group['lines']" t-as="line">
                                <article class="o_my_card o_my_in_cart" t-att-data-product-id="line.product_id.id">
                                    <img class="o_my_card_img" t-att-src="website.image_url(line.product_id, 'image_256')"
                                         t-att-alt="line.product_id.name" loading="lazy" width="64" height="64"/>
                                    <div class="o_my_card_body">
                                        <h3 class="o_my_card_name"
                                            t-esc="line.product_id.with_context(display_default_code=False).display_name"/>
                                        <div class="o_my_card_code" t-if="line.product_id.default_code">
                                            Cód. <t t-esc="line.product_id.default_code"/>
                                        </div>
                                        <div class="o_my_card_meta">
                                            <span class="o_my_card_price js_my_line_subtotal" t-esc="line.price_subtotal"
                                                  t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            <span class="o_my_card_unit">c/u <t t-esc="line.price_reduce_taxexcl"
                                                  t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/></span>
                                        </div>
                                    </div>
                                    <t t-call="website_mayorista.qty_stepper">
                                        <t t-set="qty" t-value="'%d' % line.product_uom_qty"/>
                                        <t t-set="max_qty" t-value="stock_max.get(line.product_id.id)"/>
                                    </t>
                                </article>
                            </t>
                        </div>
                    </section>

                    <t t-call="website_mayorista.totals"/>
                    <p t-if="app.wholesale_shipping_product_id and not cart['has_shipping']" class="o_my_hint">
                        El costo de envío se confirmará al revisar su pedido.
                    </p>

                    <form id="o_my_checkout_form" class="o_my_checkout" action="/mayorista/confirmar" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="o_my_ref">Su orden de compra (opcional)</label>
                        <input type="text" id="o_my_ref" name="client_ref" maxlength="64" class="form-control"/>
                        <label for="o_my_note">Observaciones (opcional)</label>
                        <textarea id="o_my_note" name="note" rows="2" class="form-control"></textarea>
                    </form>
                </t>
                <div t-else="" class="o_my_empty">
                    <i class="fa fa-shopping-basket fa-3x" aria-hidden="true"/>
                    <p>Su pedido no tiene productos todavía.</p>
                    <a href="/mayorista" class="o_my_btn o_my_btn_primary">Ir al catálogo</a>
                </div>
            </div>

            <div t-if="cart['has_lines']" class="o_my_cartbar">
                <button type="submit" form="o_my_checkout_form" class="o_my_cartbar_link o_my_confirm_btn">
                    <span>Enviar pedido</span>
                    <span class="o_my_cartbar_total js_my_total" t-esc="cart['amount_total']"/>
                </button>
            </div>
        </t>
    </template>

    <!-- =====================================================================
         CONFIRMACIÓN: /mayorista/pedido/<id> (pantalla completa en móvil)
         ===================================================================== -->
    <template id="confirmation_page" name="App Mayorista: confirmación">
        <t t-call="website_mayorista.app_layout">
            <section class="o_my_confirm" role="dialog" aria-modal="true" aria-labelledby="o_my_confirm_title">
                <div class="o_my_confirm_card">
                    <div class="o_my_confirm_icon" aria-hidden="true"><i class="fa fa-check"/></div>
                    <h1 id="o_my_confirm_title" class="o_my_confirm_title">
                        <t t-if="confirmed">Pedido confirmado</t>
                        <t t-else="">Pedido enviado</t>
                    </h1>
                    <p class="o_my_confirm_lead" t-if="confirmed">
                        Lo estamos preparando. Le avisaremos aquí cada vez que avance.
                    </p>
                    <p class="o_my_confirm_lead" t-else="">
                        Nuestro equipo lo revisará y le confirmará disponibilidad y entrega.
                    </p>

                    <div class="o_my_confirm_ref_box">
                        <span class="o_my_confirm_label">Número de pedido</span>
                        <span class="o_my_confirm_ref" t-esc="order.name"/>
                    </div>

                    <dl class="o_my_confirm_summary">
                        <div><dt>Fecha</dt><dd t-esc="order.date_order" t-options="{'widget': 'date'}"/></div>
                        <div><dt>Productos</dt><dd t-esc="cart['lines']"/></div>
                        <div><dt>Unidades</dt><dd t-esc="cart['units']"/></div>
                        <div t-if="cart['has_shipping']"><dt>Envío</dt><dd t-esc="cart['shipping']"/></div>
                        <div t-if="order.client_order_ref"><dt>Su orden de compra</dt><dd t-esc="order.client_order_ref"/></div>
                        <div class="o_my_confirm_total"><dt>Total</dt><dd t-esc="cart['amount_total']"/></div>
                    </dl>

                    <details class="o_my_confirm_lines">
                        <summary>Ver productos del pedido</summary>
                        <t t-call="website_mayorista.grouped_lines"/>
                    </details>

                    <div class="o_my_confirm_actions">
                        <a t-attf-href="/mayorista/pedidos/#{order.id}" class="o_my_btn o_my_btn_primary">Seguir mi pedido</a>
                        <a href="/mayorista" class="o_my_btn o_my_btn_ghost">Hacer otro pedido</a>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <!-- =====================================================================
         MIS PEDIDOS: /mayorista/pedidos
         ===================================================================== -->
    <template id="orders_page" name="App Mayorista: mis pedidos">
        <t t-call="website_mayorista.app_layout">
            <div class="o_my_container">
                <h1 class="o_my_page_title">Mis pedidos</h1>
                <div t-if="not orders" class="o_my_empty">
                    <i class="fa fa-truck fa-3x" aria-hidden="true"/>
                    <p>Todavía no ha enviado pedidos desde la app.</p>
                    <a href="/mayorista" class="o_my_btn o_my_btn_primary">Ir al catálogo</a>
                </div>
                <ul t-else="" class="o_my_order_list">
                    <li t-foreach="orders" t-as="o">
                        <a t-attf-href="/mayorista/pedidos/#{o.id}" class="o_my_order_item">
                            <div class="o_my_order_main">
                                <strong class="o_my_order_name" t-esc="o.name"/>
                                <span class="o_my_order_date" t-esc="o.wholesale_submitted_date or o.date_order"
                                      t-options="{'widget': 'date'}"/>
                            </div>
                            <div class="o_my_order_status">
                                <span t-attf-class="o_my_pill o_my_pill_#{o.state}" t-esc="state_labels.get(o.state)"/>
                                <span t-if="o.wholesale_stage_id and o.state != 'cancel'" class="o_my_order_stage"
                                      t-esc="o.wholesale_stage_id.name"/>
                                <span t-if="app.wholesale_show_invoice_status and o.state in ('sale', 'done')"
                                      class="o_my_order_invoice" t-esc="invoice_labels.get(o.invoice_status)"/>
                            </div>
                            <strong class="o_my_order_total" t-esc="o.amount_total"
                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </a>
                    </li>
                </ul>
            </div>
        </t>
    </template>

    <!-- =====================================================================
         DETALLE Y SEGUIMIENTO: /mayorista/pedidos/<id>
         ===================================================================== -->
    <template id="order_detail_page" name="App Mayorista: seguimiento del pedido">
        <t t-call="website_mayorista.app_layout">
            <div class="o_my_container">
                <a href="/mayorista/pedidos" class="o_my_back"><i class="fa fa-arrow-left" aria-hidden="true"/> Mis pedidos</a>
                <div class="o_my_detail_head">
                    <h1 class="o_my_page_title" t-esc="order.name"/>
                    <span t-attf-class="o_my_pill o_my_pill_#{order.state}" t-esc="state_label"/>
                </div>
                <p class="o_my_detail_meta">
                    Enviado el <t t-esc="order.wholesale_submitted_date or order.date_order" t-options="{'widget': 'date'}"/>
                    <t t-if="order.client_order_ref">. Su orden de compra: <t t-esc="order.client_order_ref"/></t>
                </p>

                <!-- Seguimiento por etapas -->
                <section t-if="timeline and order.state != 'cancel'" class="o_my_panel">
                    <h2 class="o_my_panel_title">Seguimiento</h2>
                    <ol class="o_my_timeline">
                        <li t-foreach="timeline" t-as="step" t-attf-class="o_my_step o_my_step_#{step['status']}">
                            <span class="o_my_step_dot" aria-hidden="true">
                                <i t-if="step['status'] == 'done'" class="fa fa-check"/>
                            </span>
                            <div class="o_my_step_text">
                                <strong t-esc="step['name']"/>
                                <span t-if="step['status'] == 'current'" class="sr-only">(etapa actual)</span>
                                <p t-if="step['description'] and step['status'] == 'current'" t-esc="step['description']"/>
                            </div>
                        </li>
                    </ol>
                </section>
                <div t-if="order.state == 'cancel'" class="alert alert-warning" role="alert">
                    Este pedido fue cancelado.
                </div>

                <!-- Productos agrupados por categoría -->
                <section class="o_my_panel">
                    <h2 class="o_my_panel_title">Productos</h2>
                    <t t-call="website_mayorista.grouped_lines"/>
                    <t t-call="website_mayorista.totals"/>
                    <p t-if="app.wholesale_shipping_product_id and not cart['has_shipping']" class="o_my_hint">
                        El costo de envío aún no se ha asignado.
                    </p>
                </section>

                <!-- Facturación (opcional) -->
                <section t-if="app.wholesale_show_invoice_status and order.state in ('sale', 'done')" class="o_my_panel">
                    <h2 class="o_my_panel_title">Facturación</h2>
                    <p class="o_my_invoice_status">
                        Estado: <strong t-esc="invoice_label"/>
                    </p>
                    <ul t-if="invoices" class="o_my_invoice_list">
                        <li t-foreach="invoices" t-as="inv">
                            <a t-att-href="inv['url']" class="o_my_invoice_item">
                                <span>
                                    <strong t-esc="inv['name']"/>
                                    <small t-if="inv['is_refund']"> (nota crédito)</small>
                                    <small class="d-block" t-esc="inv['date']" t-options="{'widget': 'date'}"/>
                                </span>
                                <span class="text-right">
                                    <strong t-esc="inv['amount']"/>
                                    <small t-attf-class="d-block o_my_pay o_my_pay_#{inv['payment_state']}"
                                           t-esc="inv['payment_label']"/>
                                </span>
                            </a>
                        </li>
                    </ul>
                </section>

                <button t-if="chat_enabled" type="button" class="o_my_btn o_my_btn_ghost o_my_chat_open o_my_block"
                        t-att-data-prefill="'Consulta sobre el pedido %s: ' % order.name">
                    <i class="fa fa-comments-o" aria-hidden="true"/> Consultar a mi asesor sobre este pedido
                </button>
            </div>
        </t>
    </template>

    <!-- =====================================================================
         NOTIFICACIONES: /mayorista/notificaciones
         ===================================================================== -->
    <template id="notifications_page" name="App Mayorista: notificaciones">
        <t t-call="website_mayorista.app_layout">
            <div class="o_my_container">
                <h1 class="o_my_page_title">Notificaciones</h1>
                <div t-if="not notifications" class="o_my_empty">
                    <i class="fa fa-bell-o fa-3x" aria-hidden="true"/>
                    <p>Aquí verá los avances de sus pedidos.</p>
                </div>
                <ul t-else="" class="o_my_notif_list">
                    <li t-foreach="notifications" t-as="n"
                        t-attf-class="o_my_notif o_my_notif_#{n.kind} #{'o_my_notif_unread' if n.id in unread_ids else ''}">
                        <t t-set="notif_url" t-value="'/mayorista/pedidos/%s' % n.order_id.id if n.order_id and n.order_id.wholesale_submitted else False"/>
                        <a t-if="notif_url" t-att-href="notif_url" class="o_my_notif_link">
                            <strong t-esc="n.title"/>
                            <p t-if="n.body" t-esc="n.body"/>
                            <small t-esc="n.create_date" t-options="{'widget': 'datetime'}"/>
                        </a>
                        <div t-else="" class="o_my_notif_link">
                            <strong t-esc="n.title"/>
                            <p t-if="n.body" t-esc="n.body"/>
                            <small t-esc="n.create_date" t-options="{'widget': 'datetime'}"/>
                        </div>
                    </li>
                </ul>
            </div>
        </t>
    </template>

</odoo>
