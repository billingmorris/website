<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Etiquetas PWA en <head>, solo en las pantallas de la app (variable wholesale_app) -->
    <template id="pwa_head" inherit_id="web.layout" name="App Mayorista: cabeceras PWA">
        <xpath expr="//head" position="inside">
            <t t-if="wholesale_app">
                <link rel="manifest" href="/mayorista/manifest.webmanifest"/>
                <meta name="theme-color" t-att-content="wholesale_app.wholesale_theme_color or '#2f5d8a'"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <!-- iPhone / iPad (Safari: Compartir > Agregar a pantalla de inicio) -->
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
                <meta name="apple-mobile-web-app-title"
                      t-att-content="wholesale_app.wholesale_app_short_name or wholesale_app.wholesale_app_name or 'Mayorista'"/>
                <link rel="apple-touch-icon" href="/mayorista/icon/180.png"/>
                <style t-if="wholesale_app.wholesale_hide_website_chrome">
                    header#top, footer#bottom, .o_header_affixed, .o_footer_copyright { display: none !important; }
                </style>
            </t>
        </xpath>
    </template>

    <!-- Página sin conexión que el service worker guarda en caché -->
    <template id="offline_page" name="App Mayorista: sin conexión">
        <t t-raw="'&lt;!DOCTYPE html&gt;'"/>
        <html lang="es">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title t-esc="app_name"/>
                <style>
                    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
                           font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: #f3f4f6; color: #1d2430; }
                    main { max-width: 340px; padding: 24px; text-align: center; }
                    h1 { font-size: 1.4rem; margin: 0 0 8px; }
                    p { color: #667085; margin: 0 0 20px; line-height: 1.45; }
                    button { border: 0; border-radius: 10px; padding: 12px 22px; font-size: 1rem; font-weight: 600; color: #fff; cursor: pointer; }
                </style>
            </head>
            <body>
                <main>
                    <h1>Sin conexión</h1>
                    <p>Revise su conexión a internet e intente de nuevo. Su pedido en curso queda guardado.</p>
                    <button type="button" t-attf-style="background: #{color};" onclick="location.reload()">Reintentar</button>
                </main>
            </body>
        </html>
    </template>
</odoo>
