<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuración en Sitio web > Configuración > Sitios web > (sitio) -->
    <record id="view_website_form_mayorista" model="ir.ui.view">
        <field name="name">website.form.mayorista</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="App Mayorista" name="wholesale_app">
                    <group>
                        <field name="wholesale_warehouse_id"
                               domain="[('company_id', '=', company_id)]"
                               options="{'no_create': True}"/>
                        <field name="wholesale_low_stock"/>
                        <field name="wholesale_page_size"/>
                    </group>
                    <group>
                        <field name="wholesale_auto_confirm"/>
                        <field name="wholesale_limit_stock"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
