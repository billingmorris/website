<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario dedicado a la configuración de la app (vista primaria sobre "website") -->
    <record id="view_website_wholesale_config_form" model="ir.ui.view">
        <field name="name">website.wholesale.config.form</field>
        <field name="model">website</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Ajustes de la App Mayorista">
                <sheet>
                    <div class="oe_title">
                        <label for="wholesale_app_name" class="oe_edit_only"/>
                        <h1><field name="wholesale_app_name" placeholder="App Mayorista"/></h1>
                        <div class="text-muted">Sitio web: <field name="name" readonly="1" class="oe_inline"/></div>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <notebook>
                        <page string="Apariencia e instalación" name="look">
                            <group>
                                <group string="Identidad">
                                    <field name="wholesale_app_short_name"/>
                                    <field name="wholesale_app_logo" widget="image" class="oe_avatar" options="{'size': [96, 96]}"/>
                                    <field name="wholesale_theme_color" placeholder="#2F5D8A"/>
                                </group>
                                <group string="Pantalla">
                                    <field name="wholesale_background_image" widget="image" options="{'size': [160, 100]}"/>
                                    <field name="wholesale_hide_website_chrome"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                La app se instala desde el celular abriendo <b>/mayorista</b>:
                                en Android con la opción <b>Instalar app</b> del menú de la app (o del navegador),
                                y en iPhone desde Safari con <b>Compartir → Agregar a pantalla de inicio</b>.
                                El sitio debe servirse por HTTPS.
                            </div>
                        </page>
                        <page string="Pedidos" name="orders">
                            <group>
                                <group string="Precios y equipo">
                                    <field name="wholesale_pricelist_id" options="{'no_create': True}"/>
                                    <field name="wholesale_team_id" options="{'no_create': True}"/>
                                    <field name="wholesale_shipping_product_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Al recibir un pedido">
                                    <field name="wholesale_order_state"/>
                                    <field name="wholesale_origin"/>
                                    <field name="wholesale_send_email"/>
                                    <field name="wholesale_mail_template_id"
                                           attrs="{'invisible': [('wholesale_send_email', '=', False)]}"/>
                                </group>
                                <group string="Avisos en el backend">
                                    <field name="wholesale_notify_backend"/>
                                    <field name="wholesale_notify_salesperson"
                                           attrs="{'invisible': [('wholesale_notify_backend', '=', False)]}"/>
                                    <field name="wholesale_notify_user_ids" widget="many2many_tags"
                                           attrs="{'invisible': [('wholesale_notify_backend', '=', False)]}"/>
                                    <field name="wholesale_notify_activity"
                                           attrs="{'invisible': [('wholesale_notify_backend', '=', False)]}"/>
                                </group>
                                <group string="Listas y cliente">
                                    <field name="wholesale_list_highlight"/>
                                    <field name="wholesale_list_color"
                                           attrs="{'invisible': [('wholesale_list_highlight', '=', False)]}"/>
                                    <field name="wholesale_show_invoice_status"/>
                                </group>
                            </group>
                        </page>
                        <page string="Catálogo e inventario" name="stock">
                            <group>
                                <group>
                                    <field name="wholesale_warehouse_id"
                                           domain="[('company_id', '=', company_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="wholesale_limit_stock"/>
                                </group>
                                <group>
                                    <field name="wholesale_low_stock"/>
                                    <field name="wholesale_page_size"/>
                                </group>
                            </group>
                        </page>
                        <page string="Comunicación" name="communication">
                            <group>
                                <group string="WhatsApp">
                                    <field name="wholesale_whatsapp_number" placeholder="573001234567"/>
                                    <field name="wholesale_whatsapp_use_salesperson"/>
                                    <field name="wholesale_whatsapp_message"/>
                                </group>
                                <group string="Chat en la app">
                                    <field name="wholesale_chat_enabled"/>
                                    <field name="wholesale_chat_fallback_user_id" options="{'no_create': True}"
                                           attrs="{'invisible': [('wholesale_chat_enabled', '=', False)]}"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 attrs="{'invisible': [('wholesale_chat_enabled', '=', False)]}">
                                Los mensajes del cliente llegan como mensaje directo en <b>Conversaciones</b>
                                al comercial asignado en la ficha del cliente (pestaña Ventas y compras).
                                Las respuestas desde Conversaciones aparecen en la app.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Abre directamente el sitio web actual con el formulario anterior -->
    <record id="action_wholesale_config" model="ir.actions.server">
        <field name="name">Ajustes de la App Mayorista</field>
        <field name="model_id" ref="website.model_website"/>
        <field name="state">code</field>
        <field name="code">
website = env['website'].get_current_website()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Ajustes de la App Mayorista',
    'res_model': 'website',
    'res_id': website.id,
    'view_mode': 'form',
    'views': [(env.ref('website_mayorista.view_website_wholesale_config_form').id, 'form')],
    'target': 'current',
}
        </field>
    </record>
</odoo>
